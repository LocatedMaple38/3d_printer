.SEGMENT "INT"
nmi:
  RTI

IRQ:
  PHA
  PHX
  PHY
  PHP
IRQ_1:
  BIT IFR0
  BEQ VIA0

  BIT IFR1
  BEQ VIA1

  BIT IFR2
  BEQ VIA2

  BIT IFR3
  BEQ VIA3

  BIT IFR4
  BEQ VIA4

  BIT INT0RD
  BNE skip_irq_eath
  JMP ((eathernet << 8) | INT0RD)
skip_irq_eath:
  PLP
  PLY
  PLX
  PLA
  RTI

VIA0:
  LDX IFR0
  TXA
  AND #%00000001
  BEQ VIA0CA2
  TXA
  AND #%00000010
  BEQ VIA0CA1
  TXA
  AND #%00000100
  BEQ VIA0SR
  TXA
  AND #%00001000
  BEQ VIA0T2
  TXA
  AND #%01000000
  BEQ VIA0T1
  JMP IRQ_1

VIA1:
  LDX IFR1
  TXA
  AND #%00000001
  BEQ VIA1CA2
  TXA
  AND #%00000010
  BEQ VIA1CA1
  TXA
  AND #%00000100
  BEQ VIA1SR
  TXA
  AND #%00001000
  BEQ VIA1T2
  TXA
  AND #%01000000
  BEQ VIA1T1
  JMP IRQ_1

VIA2:
  LDX IFR2
  TXA
  AND #%00000001
  BEQ VIA2CA2
  TXA
  AND #%00000010
  BEQ VIA2CA1
  TXA
  AND #%00000100
  BEQ VIA2SR
  TXA
  AND #%00001000
  BEQ VIA2T2
  TXA
  AND #%00010000
  BEQ VIA2CB2
  TXA
  AND #%00100000
  BEQ VIA2CB1
  TXA
  AND #%01000000
  BEQ VIA2T1
  JMP IRQ_1

VIA2T1:
  JMP VIA2

VIA2T2:
  JMP VIA2

VIA2CB1:
  JMP VIA2

VIA2CB2:
  JMP VIA2

VIA2SR:
  JMP VIA2

VIA2CA1:
  JMP VIA2

VIA2CA2:
  JMP VIA2

VIA3:
  LDX IFR3
  TXA
  AND #%00000001
  BEQ VIA3CA2
  TXA
  AND #%00000010
  BEQ VIA3CA1
  TXA
  AND #%00000100
  BEQ VIA3SR
  TXA
  AND #%00001000
  BEQ VIA3T2
  TXA
  AND #%00010000
  BEQ VIA3CB2
  TXA
  AND #%00100000
  BEQ VIA3CB1
  TXA
  AND #%01000000
  BEQ VIA3T1
  JMP IRQ_1

VIA4:
  LDX IFR4
  TXA
  AND #%00000001
  BEQ VIA4CA2
  TXA
  AND #%00000010
  BEQ VIA4CA1
  TXA
  AND #%00000100
  BEQ VIA4SR
  TXA
  AND #%00001000
  BEQ VIA4T2
  TXA
  AND #%00010000
  BEQ VIA4CB2
  TXA
  AND #%00100000
  BEQ VIA4CB1
  TXA
  AND #%01000000
  BEQ VIA4T1
  JMP IRQ_1

VIA0T1:
  JMP VIA0

VIA0T2:
  JMP VIA0

VIA0SR:
  JMP VIA0

VIA0CA1:		   ;x axis limit
  JMP VIA0

VIA0CA2:		   ;y axis limit
  JMP VIA0

VIA1T1:
  JMP VIA1

VIA1T2:
  JMP VIA1

VIA1SR:
  JMP VIA1

VIA1SR_disp_init:
  LDA status
  AND #%1100000
  TAX
  LDA disp_addr, x
  INX
  STA SR1
  JMP VIA1

VIA1CA1:
  JMP VIA1

VIA1CA2:
  JMP VIA1

VIA3T1:
  JMP VIA3

VIA3T2:
  JMP VIA3

VIA3CB1:
  JMP VIA3

VIA3CB2:
  JMP VIA3

VIA3SR:
  JMP VIA3

VIA3CA1:
  JMP VIA3

VIA3CA2:
  JMP VIA3

VIA4T1:
  JMP VIA4

VIA4T2:
  JMP VIA4

VIA4CB1:
  JMP VIA4

VIA4CB2:
  JMP VIA4

VIA4SR:
  JMP VIA4

VIA4CA1:
  JMP VIA4

VIA4CA2:
  JMP VIA4
